# Copie para .env e ajuste. O .env nunca vai para o git.

# --- AWS (só para deploy/execução na nuvem) ---
# Prefira um perfil de um usuário IAM dedicado (aws configure --profile ans-bi).
# Nunca use chaves da conta root.
AWS_PROFILE=ans-bi
AWS_DEFAULT_REGION=sa-east-1
# e-mail que recebe alertas do orçamento mensal (make deploy)
ALERT_EMAIL=

# --- pipeline ---
# onde fica o lake: diretório local (padrão) ou s3://nome-do-bucket
ANS_LAKE_URI=data/lake
# primeiro ano do histórico
ANS_START_YEAR=2021
# meses que a execução diária revisita nas bases mensais
ANS_LOOKBACK_MONTHS=3
# restringe UFs (útil para testar rápido); vazio = todas
ANS_UFS=
# limites do DuckDB por processo
ANS_DUCKDB_MEMORY=2GB
ANS_DUCKDB_THREADS=2
